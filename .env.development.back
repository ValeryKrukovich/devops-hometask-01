PORT=3000 // находится внутри container, поэтому он должен слушать внутренний порт от -p 13000:3000

DB_HOST=todo-db-container  // контейнер базы данных --name todo-db-container
DB_PORT=5432
DB_USER=todo // из env db
DB_PASSWORD=todo // из env db
DB_NAME=todo // из env db

CORS_ORIGIN=http://localhost:18080 // фронт делает запрос с этого адресса